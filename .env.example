# ====================================================================
# Home Channel HLS - Environment Configuration Template
# Copy this file to .env and customize for your station.
# ====================================================================

# --------------------------------------------------------------------
# General Channel Identity & Server Settings
# --------------------------------------------------------------------
CHANNEL_NAME="Home Channel"
CHANNEL_CALLSIGN="CH-01"
PORT=3000
TZ=America/Bogota
PUBLIC_BASE_URL=http://localhost:3000

# --------------------------------------------------------------------
# Master Control Security (Web Admin Panel)
# --------------------------------------------------------------------
# Initial password for the /admin Master Control Studio
ADMIN_PASSWORD=change_this_password_immediately
# Secret used for signing cryptographically secure session cookies
ADMIN_SECRET=change_this_to_a_long_random_string_xyz123

# --------------------------------------------------------------------
# PostgreSQL Database Settings
# --------------------------------------------------------------------
POSTGRES_USER=channel_user
POSTGRES_PASSWORD=channel_secure_password_99
POSTGRES_DB=homechannel
PG_HOST=db
PG_PORT=5432

# --------------------------------------------------------------------
# Hardware Acceleration & Video Encoding
# Options: auto (detects NVENC / VAAPI / VideoToolbox / CPU fallback)
# --------------------------------------------------------------------
VIDEO_ENCODER=auto

# --------------------------------------------------------------------
# Optional: Dynamic Voiceover & TTS for "Next Up" Announcements
# --------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME="Announcer"
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional Local TTS fallback (edge-tts is built-in; Ollama is optional)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
